# Copy to .env.local for local development. On Vercel, add these under Project Settings > Environment Variables.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The public URL of the site, used in email links
NEXT_PUBLIC_SITE_URL=https://cee.example.org

# Optional: let applicants sign in with a text message code (needs Twilio set up in Supabase Auth)
NEXT_PUBLIC_ENABLE_SMS_LOGIN=false

# Optional: email notifications through Resend (https://resend.com). Without these, emails are only logged.
RESEND_API_KEY=
EMAIL_FROM="Community Equity Endowment <no-reply@your-domain.org>"

# Never add the Supabase service-role key. The app doesn't need it.
