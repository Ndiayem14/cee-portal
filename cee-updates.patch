diff --git a/supabase/migrations/0002_lock_down_functions.sql b/supabase/migrations/0002_lock_down_functions.sql
new file mode 100644
index 0000000..6ae1faa
--- /dev/null
+++ b/supabase/migrations/0002_lock_down_functions.sql
@@ -0,0 +1,43 @@
+-- Lock down internal functions (Supabase security advisor: SECURITY DEFINER functions callable by anon).
+--
+-- 1. All policies on our tables apply to signed-in users only, so signed-out visitors
+--    never touch them (they're denied by default with RLS on).
+-- 2. Trigger functions can't be called by anyone through the API.
+--    (Triggers still run: Postgres doesn't check the caller's EXECUTE right for trigger functions.)
+-- 3. Helper functions used inside policies can only be called by signed-in users.
+
+do $$
+declare p record;
+begin
+  for p in
+    select policyname, tablename from pg_policies
+    where schemaname = 'public'
+      and tablename in ('profiles', 'applications', 'address_history', 'documents',
+                        'info_requests', 'review_notes', 'audit_log')
+  loop
+    execute format('alter policy %I on public.%I to authenticated', p.policyname, p.tablename);
+  end loop;
+end $$;
+
+revoke execute on function
+  public.handle_new_user(),
+  public.applications_guard(),
+  public.applications_insert_guard(),
+  public.resolve_info_requests()
+from public, anon, authenticated;
+
+revoke execute on function
+  public.is_staff(),
+  public.is_admin(),
+  public.my_role(),
+  public.can_edit_application(uuid),
+  public.owns_application(uuid)
+from public, anon;
+
+grant execute on function
+  public.is_staff(),
+  public.is_admin(),
+  public.my_role(),
+  public.can_edit_application(uuid),
+  public.owns_application(uuid)
+to authenticated;
diff --git a/supabase/tests/00_mock_supabase.sql b/supabase/tests/00_mock_supabase.sql
index ede9f52..d85a10f 100644
--- a/supabase/tests/00_mock_supabase.sql
+++ b/supabase/tests/00_mock_supabase.sql
@@ -15,7 +15,7 @@ create function storage.foldername(name text) returns text[] language sql immuta
   select (string_to_array(name, '/'))[1:array_length(string_to_array(name, '/'),1)-1] $$;
 grant usage on schema public, auth, storage to anon, authenticated;
 grant execute on all functions in schema auth to anon, authenticated;
-grant all on storage.objects to authenticated;
+grant all on storage.objects to anon, authenticated;
 alter default privileges in schema public grant all on tables to anon, authenticated, service_role;
 alter default privileges in schema public grant all on sequences to anon, authenticated, service_role;
 alter default privileges in schema public grant execute on functions to anon, authenticated, service_role;
diff --git a/supabase/tests/rls_test.py b/supabase/tests/rls_test.py
index 368caa2..3090634 100644
--- a/supabase/tests/rls_test.py
+++ b/supabase/tests/rls_test.py
@@ -28,6 +28,19 @@ def as_user(uid, aal="aal1"):
                 raise
     return run
 
+def as_anon(sql, *args):
+    with conn.cursor() as c:
+        c.execute("begin")
+        try:
+            c.execute("set local role anon")
+            c.execute(sql, args)
+            rows = c.fetchall() if c.description else c.rowcount
+            c.execute("commit")
+            return rows
+        except Exception:
+            c.execute("rollback")
+            raise
+
 def check(name, fn, expect_error=False):
     try:
         out = fn()
@@ -117,6 +130,11 @@ check("decided_at and reviewer recorded",
 check("applicant cannot change role to admin", lambda: a("update profiles set role='admin' where id=%s", A) == 0)
 check("is_staff() false for applicant", lambda: a("select public.is_staff()")[0][0] is False)
 
+check("signed-out visitor sees no applications", lambda: as_anon("select * from applications") == [])
+check("signed-out visitor sees no files", lambda: as_anon("select * from storage.objects") == [])
+check("signed-out visitor cannot call is_staff()", lambda: as_anon("select public.is_staff()"), expect_error=True)
+check("nobody can call trigger functions directly", lambda: a("select public.handle_new_user()"), expect_error=True)
+
 passed = sum(ok for ok, *_ in results)
 for ok, name, why in results:
     print(("PASS " if ok else "FAIL ") + name + (f"  -> {why}" if why else ""))
